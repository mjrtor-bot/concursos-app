FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_CONTABO_AUTH_MODE
ENV NEXT_PUBLIC_CONTABO_AUTH_MODE=$NEXT_PUBLIC_CONTABO_AUTH_MODE
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app ./
EXPOSE 3000
CMD ["npm", "run", "start"]
